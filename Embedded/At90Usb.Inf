[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGUID   = {88BA0301-5B15-11CF-8DDD-00AA000386C6}
Provider    = %ManufacturerName%
CatalogFile = MyUsbDevice.cat
DriverVer   = 07/03/2026,1.0.0.0

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%DeviceName% = MyUsbDevice_Install, USB\VID_XXXX&PID_YYYY

[MyUsbDevice_Install]
CopyFiles = MyUsbDevice_CopyFiles

[MyUsbDevice_Install.Services]
AddService = WinUsb, 0x00000002, WinUsb_ServiceInstall

[WinUsb_ServiceInstall]
DisplayName   = %WinUsb_DisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\winusb.sys

[MyUsbDevice_CopyFiles]
winusb.sys

[DestinationDirs]
DefaultDestDir = 12

[Strings]
ManufacturerName   = "TBD"
DeviceName         = "AT90USB"
WinUsb_DisplayName = "WinUSB Device Service"
