;
; Universal INF file for WinUsb installation
;

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGUID   = {4d36e97e-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = WinUSBInstallation.cat
DriverVer   = 03/11/2026,13.54.20.543
PnpLockdown = 1

; ========== Manufacturer and Models sections ===========

[Manufacturer]
%ManufacturerName% = Standard,NTamd64,NTarm64

[Standard.NTamd64]
%DeviceName% =USB_Install, USB\VID_03EB&PID_2103\00B0000006B4

[Standard.NTarm64]
%DeviceName% =USB_Install, USB\VID_03EB&PID_2103\00B0000006B4

; =================== Installation ===================

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.HW]
AddReg=Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{F1ADFDA0-80BA-4176-BD98-5AB5D160CE16}"

; =================== Strings ===================

[Strings]
ManufacturerName="Atmel"
ClassName="Other Bus devices"
DeviceName="JTAGICE mkII"
REG_MULTI_SZ = 0x00010000