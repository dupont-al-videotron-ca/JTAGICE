<log4net>
  <layout name="DefaultLayout" type="log4net.Layout.PatternLayout">
    <conversionPattern value="%date %-5level%30.30logger, %message%newline" />
  </layout>
  <appender name="FileAppender" type="log4net.Appender.FileAppender">
    <file value="log.txt" />
    <appendToFile value="false" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %30.30logger, %message%newline" />
    </layout>
  </appender>
  <appender name="XUnitTestAppender" type="Common.Test.Xunit.XUnitTestAppender">
  </appender>
  <!-- Set root logger level to DEBUG and its only appender to ConsoleAppender -->
  <root>
    <level value="DEBUG" />
    <appender-ref ref="FileAppender" />
    <appender-ref ref="XUnitTestAppender" />
  </root>
</log4net>